<%- include('partials/head', { pageTitle: 'Vaje' }) %>
<% const f = fmt; %>
<section class="hello">
  <div>
    <h1><%= user.name %></h1>
    <p class="big-line"><strong><%= f.num(total.score) %></strong> od <%= maxPoints %> točk, <%= total.done %> od <%= maxTasks %> nalog, <%= f.duration(total.seconds) %> dela</p>
  </div>
  <% if (next_) { %>
  <a class="btn big" href="/vaje/<%= next_.id %>"><%= nextStarted ? 'Nadaljuj' : 'Začni' %> vajo <%= next_.no %>: <%= next_.title %></a>
  <% } else if (maxTasks) { %><p class="all-done">Vse naloge so rešene.</p><% } %>
</section>
<% if (!user.isAdmin) { %><section class="my-note">
  <span data-note-slot data-box="note-general" data-heading="Moja splošna opomba" data-csrf="<%= csrf %>" data-label="Moja splošna opomba"></span>
  <div class="lvn-text" id="note-general" <%- generalNote ? '' : 'hidden' %>><%= generalNote %></div>
</section><% } %>
<% if (!mods.length) { %><p class="empty">Učitelj še ni odprl nobene vaje. Ko jih odpre, se pojavijo tukaj.</p><% } %>
<% mods.forEach((m) => { %>
<section class="module">
  <h2><span class="m-no"><%= m.id %></span> <%= m.title %></h2>
  <ol class="rail">
    <% m.exercises.forEach((e) => { const r = rows.get(e.id); const finished = r.done === e.tasks.length; %>
    <li class="node <%= finished ? 'lit' : r.started ? 'half' : '' %>">
      <div class="ex-main">
        <h3><a href="/vaje/<%= e.id %>"><span class="ex-no"><%= e.no %></span> <%= e.title %></a></h3>
        <%- include('partials/strip', { items: r.strip }) %>
        <p class="ex-meta"><%= f.num(r.score) %> od <%= e.maxPoints %> točk, <%= r.done %> od <%= e.tasks.length %> nalog<% if (r.resets) { %>, ponastavljeno <%= r.resets %>-krat<% } %><% if (taskNotes.get(e.id)) { %>, opombe pri nalogah: <%= taskNotes.get(e.id) %><% } %>
          <% if (!user.isAdmin) { %><span data-note-slot data-box="note-<%= e.id %>" data-exercise="<%= e.id %>" data-heading="Opomba k vaji <%= e.no %>" data-csrf="<%= csrf %>"></span><% } %></p>
        <% if (!user.isAdmin) { %><div class="lvn-text" id="note-<%= e.id %>" <%- exerciseNote.get(e.id) ? '' : 'hidden' %>><%= exerciseNote.get(e.id) || '' %></div><% } %>
      </div>
      <dl class="times">
        <div><dt>Teorija</dt><dd><%= f.duration(r.time.Teorija) %></dd></div>
        <div><dt>Simulacija</dt><dd><%= f.duration(r.time.Simulacija) %></dd></div>
        <div><dt>Naloge</dt><dd><%= f.duration(r.time.Naloge) %></dd></div>
      </dl>
      <a class="btn <%= r.started && !finished ? '' : 'ghost' %>" href="/vaje/<%= e.id %>" aria-label="<%= finished ? 'Odpri' : r.started ? 'Nadaljuj' : 'Začni' %> vajo <%= e.no %>"><%= finished ? 'Odpri' : r.started ? 'Nadaljuj' : 'Začni' %></a>
    </li>
    <% }) %>
  </ol>
</section>
<% }) %>
<%- include('partials/legend') %>
<script src="<%= asset('js/notes.js') %>"></script>
<%- include('partials/foot') %>
