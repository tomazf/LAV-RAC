<%- include('partials/head', { pageTitle: 'Vaje' }) %>
<% const f = fmt; %>
<section class="hello">
  <div>
    <h1><%= user.name %></h1>
    <p class="big-line"><strong><%= f.num(total.score) %></strong> od <%= maxPoints %> točk, <%= total.done %> od <%= maxTasks %> nalog, <%= f.duration(total.seconds) %> dela</p>
  </div>
  <% if (next_) { %>
  <a class="btn big" href="/vaje/<%= next_.id %>"><%= nextStarted ? 'Nadaljuj' : 'Začni' %> vajo <%= next_.no %>: <%= next_.title %></a>
  <% } else if (maxTasks) { %><p class="all-done">Vse naloge so rešene.</p><% } %>
</section>
<% if (flagText) { %><p class="notice-warn" role="status"><strong>! Opozorilo:</strong> <%= flagText %></p><% } %>
<% if (!mods.length) { %><p class="empty">Učitelj še ni odprl nobene vaje. Ko jih odpre, se pojavijo tukaj.</p><% } %>
<%- include('partials/rail', { groups: mods }) %>
<% if (past.length) { %>
<section class="past-years" aria-labelledby="past-h">
  <h2 id="past-h">Prejšnji letniki</h2>
  <p class="dim">Vaje nižjih letnikov so odprte za ponavljanje. Točke tukaj se ne štejejo v letošnji pregled in jih učitelj ne vidi.</p>
  <%- include('partials/rail', { groups: past }) %>
</section>
<% } %>
<%- include('partials/legend') %>
<%- include('partials/foot') %>
