<%- include('../partials/head', { pageTitle: 'Razredi', mainClass: 'wide' }) %>
<%- include('../partials/adminnav') %>
<form class="inline" method="post" action="/admin/razredi"><input type="hidden" name="_csrf" value="<%= csrf %>">
  <label class="sr" for="novi">Ime novega razreda</label><input id="novi" name="name" required maxlength="80" placeholder="npr. R2A">
  <% if (YEARS.length) { %><label class="sr" for="novi-letnik">Letnik</label><select id="novi-letnik" name="year" required><option value="">Letnik …</option><% YEARS.forEach((y) => { %><option value="<%= y.year %>"><%= y.year %>. letnik</option><% }) %></select><% } %><button class="btn">Ustvari razred</button></form>
<% if (!classes.length) { %><p class="empty">Še ni razredov. Vpiši ime zgoraj. Učitelji se nato sami pridružijo ali jih dodaš ti.</p><% } else { %>
<div class="scroll block"><table class="data"><thead><tr><th class="l">Razred</th><% if (YEARS.length) { %><th class="l">Letnik</th><% } %><th>Dijaki</th><th class="l">Učitelji</th><th class="l">Dodaj učitelja</th><th class="l">Urejanje</th></tr></thead><tbody>
<% classes.forEach((c) => { const free = teachers.filter((t) => !c.teachers.some((x) => x.id === t.id)); %><tr>
  <td class="l"><a href="/ucitelj/razredi/<%= c.id %>"><strong><%= c.name %></strong></a></td>
  <% if (YEARS.length) { %><td class="l"><form class="inline tight year-form" method="post" action="/admin/razredi/<%= c.id %>/letnik"><input type="hidden" name="_csrf" value="<%= csrf %>">
    <label class="sr" for="y<%= c.id %>">Letnik razreda <%= c.name %></label><select id="y<%= c.id %>" name="year"><% if (!c.year) { %><option value="">brez letnika</option><% } %><% YEARS.forEach((y) => { %><option value="<%= y.year %>" <%= c.year === y.year ? 'selected' : '' %>><%= y.year %>. letnik</option><% }) %></select>
    <% if (pastLabel(c.year)) { %><label class="switch"><input type="checkbox" name="show_past" <%= c.show_past ? 'checked' : '' %>> vidi <%= pastLabel(c.year) %></label><% } %><button class="btn ghost small">Shrani</button></form></td><% } %>
  <td><%= c.students %></td>
  <td class="l"><% if (!c.teachers.length) { %><span class="dim">še brez učitelja</span><% } %><% c.teachers.forEach((t) => { %>
    <form class="teacher-chip" method="post" action="/admin/razredi/<%= c.id %>/ucitelji/<%= t.id %>/odstrani"><input type="hidden" name="_csrf" value="<%= csrf %>"><span><%= t.name %></span><button aria-label="Odstrani učitelja <%= t.name %> iz razreda <%= c.name %>" title="Odstrani iz razreda">×</button></form><% }) %></td>
  <td class="l"><% if (free.length) { %><form class="inline tight add-teacher" method="post" action="/admin/razredi/<%= c.id %>/ucitelji"><input type="hidden" name="_csrf" value="<%= csrf %>">
    <label class="sr" for="u<%= c.id %>">Učitelj za razred <%= c.name %></label><select id="u<%= c.id %>" name="user"><% free.forEach((t) => { %><option value="<%= t.id %>"><%= t.name %></option><% }) %></select><button class="btn ghost small">Dodaj</button></form><% } else { %><span class="dim">ni drugih učiteljev</span><% } %></td>
  <td class="l"><details class="danger-zone inline-details"><summary>Preimenuj ali izbriši</summary>
    <form class="inline tight" method="post" action="/admin/razredi/<%= c.id %>/preimenuj"><input type="hidden" name="_csrf" value="<%= csrf %>"><label class="sr" for="n<%= c.id %>">Novo ime</label><input id="n<%= c.id %>" name="name" value="<%= c.name %>" required maxlength="80"><button class="btn ghost small">Preimenuj</button></form>
    <p>Če izbrišeš razred, dijaki obdržijo napredek, a nimajo dostopa, dokler jih učitelj ne doda v drug razred.</p>
    <form method="post" action="/admin/razredi/<%= c.id %>/izbrisi"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn danger small">Da, izbriši razred <%= c.name %></button></form></details></td>
</tr><% }) %></tbody></table></div><% } %>
<%- include('../partials/foot') %>
