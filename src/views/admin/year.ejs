<%- include('../partials/head', { pageTitle: 'Šolsko leto', mainClass: 'wide' }) %>
<% const f = fmt; const people = (n) => f.count(n, f.DIJAKOV); const RAZREDOV = ['razred', 'razreda', 'razredi', 'razredov'];
   const sum = (list) => list.reduce((a, c) => a + c.students.length, 0);
   const teachersOut = moving.reduce((a, c) => a + c.teachers.length, 0); %>
<%- include('../partials/adminnav') %>
<% if (error) { %><p class="notice-warn" role="alert"><%= error %></p><% } %>
<section class="block year-intro">
  <h2>Zaključek šolskega leta</h2>
  <ul class="year-sum">
    <li>Izbris: <b><%= f.count(leaving.length, RAZREDOV) %></b> <%= finalYear %>. letnika, <%= people(sum(leaving)) %></li>
    <li>Napredovanje: <b><%= f.count(moving.length, RAZREDOV) %></b>, <%= people(sum(moving)) %><%= teachersOut ? `, odstranjeni učitelji: ${teachersOut}` : '' %></li>
    <% if (other.length) { %><li>Ostane brez spremembe: <b><%= f.count(other.length, RAZREDOV) %></b> brez letnika (<%= other.map((c) => c.name).join(', ') %>)</li><% } %>
  </ul>
  <details class="year-what"><summary>Kaj se zgodi ob potrditvi</summary><ul>
    <li>Označeni dijaki <%= finalYear %>. letnika se <strong>trajno izbrišejo</strong> z napredkom in vsemi zapisi, njihovi razredi tudi. Odznačeni ostanejo v portalu brez razreda. Izbrisanih dijakov ne vrne niti obnovitev kopije.</li>
    <li>Drugi razredi preidejo v višji letnik in dobijo novo ime. Poglavja novega letnika so zaprta, dokler jih učitelj ne odpre.</li>
    <li>Učitelji se odstranijo iz razredov, ki napredujejo; po prehodu jih dodeliš na strani Razredi.</li>
    <li>Napredek dijakov ostane, tudi naloge nižjih letnikov: razredi jih vidijo za ponavljanje, dokler skrbnik pri razredu ne izklopi prejšnjih letnikov.</li>
    <li>Dijak, ki ne napreduje, ostane brez razreda in nima dostopa do vaj, dokler ga učitelj ali skrbnik ne doda v razred.</li>
  </ul></details>
  <% if (lastRun) { %><p class="dim">Zadnji zaključek šolskega leta: <%= f.dateTime(lastRun) %> (<%= f.ago(lastRun) %>).</p><% } %>
</section>
<form method="post" action="/admin/solsko-leto" class="year-end">
<input type="hidden" name="_csrf" value="<%= csrf %>">
<% const students = (c, field, hidden) => { %>
  <% if (c.students.length) { %>
  <div class="year-tools"><span class="dim" data-count><%= people(c.students.length) %></span><button type="button" class="year-pick" data-check="all">vsi</button><button type="button" class="year-pick" data-check="none">nobeden</button></div>
  <ul class="checks"><% c.students.forEach((s) => { %><li><label title="<%= s.email || s.username %>"><input type="hidden" name="<%= hidden %>" value="<%= s.id %>"><input type="checkbox" name="<%= field %>" value="<%= s.id %>" checked> <%= s.name %></label></li><% }) %></ul>
  <% } else { %><p class="dim">Brez dijakov.</p><% } %>
<% } %>
<% sections.forEach((sec) => { %>
<section class="year-sec" aria-labelledby="y<%= sec.year %>">
  <h2 class="year-h" id="y<%= sec.year %>"><%= sec.last ? `${sec.year}. letnik: izbris` : `${sec.year}. → ${sec.year + 1}. letnik` %></h2>
  <p class="dim"><%= f.count(sec.classes.length, RAZREDOV) %>, <%= people(sum(sec.classes)) %>. <%= sec.last ? 'Označeni dijaki se trajno izbrišejo, odznačeni ostanejo brez razreda.' : 'Označeni dijaki gredo z razredom, odznačeni ostanejo brez razreda.' %></p>
  <% if (!sec.classes.length) { %><p class="empty">Ni razredov <%= sec.year %>. letnika.</p><% } %>
  <div class="year-grid">
  <% sec.classes.forEach((c) => { %>
    <% if (sec.last) { %>
    <article class="year-card leave">
      <header><h3><%= c.name %></h3><span class="tag year-bad">izbriše se</span></header>
      <% students(c, 'erase', 'leaving') %>
    </article>
    <% } else { %>
    <article class="year-card">
      <header><h3><%= c.name %> <span aria-hidden="true">→</span></h3>
        <label class="sr" for="name_<%= c.id %>">Novo ime razreda <%= c.name %></label><input id="name_<%= c.id %>" class="year-name" name="name_<%= c.id %>" value="<%= c.next %>" required maxlength="80">
        <span class="tag"><%= c.year %>. → <%= c.year + 1 %>. letnik</span></header>
      <% if (c.clash) { %><p class="year-clash" role="alert">Razred z imenom <%= c.next %> že obstaja in ostane. Izberi drugo ime.</p><% } %>
      <% if (c.teachers.length) { %><p class="dim">Odstranjeni učitelji: <%= c.teachers.join(', ') %></p><% } %>
      <% students(c, 'keep', 'moving') %>
    </article>
    <% } %>
  <% }) %>
  </div>
</section>
<% }) %>
<section class="block year-confirm">
  <h2>Potrditev</h2>
  <% if (fresh) { %><p class="dim">Trenutno stanje je bilo pred kratkim preneseno, zato lahko razrede, učitelje in odprta poglavja vrneš z obnovitvijo; izbrisani dijaki ostanejo izbrisani.</p>
  <% } else { %><p class="notice-warn">Najprej <a href="/admin/kopije">prenesi svežo varnostno kopijo</a>. Brez nje prehoda ni mogoče potrditi.</p><% } %>
  <% const eraseNames = leaving.flatMap((c) => c.students.map((x) => x.name)); %>
  <div class="year-live">
    <p class="notice-warn" data-sum="erase" role="status" <%= eraseNames.length ? '' : 'hidden' %>><strong>V razredih <%= finalYear %>. letnika so še dijaki (<span data-n><%= eraseNames.length %></span>):</strong> <span data-names><%= eraseNames.join(', ') %></span>. Ob potrditvi se <strong>trajno izbrišejo</strong> z napredkom in vsemi zapisi. Če katerega želiš obdržati, ga odznači zgoraj.</p>
    <p class="notice-warn" data-sum="free" role="status" hidden><strong>Po prehodu ostanejo brez razreda (<span data-n>0</span>):</strong> <span data-names></span>. V portalu ostanejo, vendar nimajo dostopa do vaj, dokler jih učitelj ali skrbnik ne doda v razred (Administracija > Uporabniki).</p>
  </div>
  <div class="stack">
    <label data-ack <%= eraseNames.length ? '' : 'hidden' %>><input type="checkbox" name="ack" value="1" <%= eraseNames.length ? 'required' : '' %>> Razumem, da se našteti dijaki trajno izbrišejo in jih ni mogoče obnoviti</label>
    <% if (lastRun && Date.now() - new Date(lastRun) < againDays * 864e5) { %><p class="notice-warn">Šolsko leto je bilo zaključeno <%= f.ago(lastRun) %>. Drugi zaključek bi razrede premaknil še za en letnik.</p>
    <label><input type="checkbox" name="again" value="1"> Vem, da je bilo šolsko leto že zaključeno, in ga želim zaključiti znova</label><% } %>
    <label for="potrdi">Za potrditev vpiši <%= word %></label>
    <input id="potrdi" name="potrdi" autocomplete="off" required>
    <button class="btn danger">Zaključi šolsko leto</button>
  </div>
</section>
</form>
<script src="<%= asset('js/year.js') %>"></script>
<%- include('../partials/foot') %>
