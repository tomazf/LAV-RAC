<%- include('../partials/head', { pageTitle: 'SQL peskovnik', mainClass: 'wide' }) %>
<link rel="stylesheet" href="<%= asset('css/sqlbox.css') %>">
<% const f = fmt; const task = (o) => JSON.stringify(o); %>
<script src="<%= asset('js/sqltask.js') %>" defer></script>
<%- include('../partials/adminnav') %>
<% if (error) { %><p class="notice-warn" role="alert"><%= error %></p><% } %>
<p class="lead-sql">SQL peskovnik je za dijake <strong>4. letnika</strong>: vsak dijak ima na strežniku MySQL svojo bazo in račun, stavke izvaja v portalu ali v MySQL Workbenchu. Strežnik vpišeš samo ti; baze dijakov ustvarjajo učitelji pri svojih razredih.</p>

<% if (!keyOk) { %>
<section class="block sql-card warn">
  <h2>Najprej ključ za šifriranje</h2>
  <p>Gesla računov MySQL so v bazi portala šifrirana s ključem <code>SQL_KEY</code> iz datoteke <code>.env</code>. Ključa še ni (ali ni dolg 32 bajtov), zato je peskovnik izklopljen.</p>
  <ol class="plain">
    <li>Na strežniku portala ustvari ključ: <code>openssl rand -base64 32</code></li>
    <li>V <code>.env</code> dodaj vrstico <code>SQL_KEY=…</code> in znova zaženi portal (<code>docker compose up -d</code>).</li>
    <li>Ključ shrani tudi na varno mesto: ni del varnostne kopije, brez njega se gesel iz kopije ne da prebrati.</li>
  </ol>
</section>
<% } %>

<% const dis = keyOk ? '' : 'disabled'; %>
<% if (s && s.checked_at && !editing) { %>
<section class="block sql-card cfg" id="streznik">
  <div class="cfg-sum">
    <h2>Strežnik MySQL</h2>
    <span class="tag ok">povezava deluje · <%= (s.server_version || '').split('-')[0] %></span>
    <div class="cfg-push">
      <form method="post" action="/admin/sql/preizkus" data-task="<%= task({ title: 'Preizkus povezave', lead: 'Portal se prijavi na strežnik MySQL s skrbniškim računom in preveri, ali lahko ustvarja baze in uporabnike.', bullets: ['Prijavi se kot ' + s.admin_user + ' na ' + s.host + ':' + s.port + '.', 'Ustvari in takoj izbriše preizkusno bazo in preizkusnega uporabnika (s predpono ' + s.prefix + ').', 'Dijakovih baz in podatkov se ne dotakne. Traja nekaj sekund.'], confirm: 'Preizkusi povezavo' }) %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn ghost small">Preizkusi</button></form>
      <form method="post" action="/admin/sql/celoten-preizkus" data-task="<%= task({ title: 'Celoten preizkus', lead: 'Portal preizkusi vse, kar delajo dijaki, in vse, česar ne smejo, z začasnim računom, ki ga na koncu izbriše.', bullets: ['Ustvari začasen račun ' + s.prefix + 'u0 z bazama ' + s.prefix + 'u0_4_4 in ' + s.prefix + 'u0_4_6.', 'V obeh bazah ustvari tabelo, vpiše, prebere, spremeni in izbriše podatke ter ponastavi bazo na predlogo.', 'Preveri, da račun ne vidi tujih baz, ne ustvarja baz, ne bere sistemskih podatkov in ne daje pravic; preveri omejitev časa in povezav ter skupni bazi.', 'Na koncu izbriše začasni račun in bazi. Pravih dijakov in njihovih baz se ne dotakne. Traja okoli 10 sekund.'], confirm: 'Zaženi preizkus' }) %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn ghost small">Celoten preizkus</button></form>
      <a class="btn small" href="/admin/sql?uredi=1#streznik">Uredi</a>
    </div>
    <dl class="cfg-dl"><div><dt>Strežnik</dt><dd><%= s.host %>:<%= s.port %></dd></div><div><dt>Račun</dt><dd><%= s.admin_user %></dd></div><div><dt>Predpona</dt><dd><%= s.prefix %></dd></div><div><dt>TLS</dt><dd><%= s.tls ? (s.ca ? 'da, s CA' : 'da') : 'ne' %></dd></div></dl>
    <p class="cfg-line">Omejitve: <%= limits.timeout %> s na stavek · <%= limits.rows %> vrstic · baza do <%= limits.sizeMb %> MB · skript do <%= limits.scriptKb %> kB · <%= limits.perMinute %> zagonov na minuto · <%= limits.connections %> povezav na račun · preizkušeno <%= f.dateTime(s.checked_at) %></p>
  </div>
</section>
<% } else { %>
<section class="block sql-card cfg" id="streznik">
  <div class="sql-card-h"><h2>Strežnik MySQL</h2>
    <span class="tag <%= s && s.checked_at ? 'ok' : 'warn' %>"><%= !s ? 'še ni nastavljen' : s.checked_at ? `povezava deluje · ${(s.server_version || '').split('-')[0]}` : 'povezava ne deluje' %></span></div>
  <form class="cfg-form" method="post" action="/admin/sql/nastavitve" autocomplete="off"><input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="cfg-row">
      <label>Naslov (IP ali ime)<input id="host" name="host" required value="<%= s?.host ?? '' %>" placeholder="npr. 10.10.12.40" <%= dis %>></label>
      <label>Vrata<input id="port" name="port" type="number" min="1" max="65535" value="<%= s?.port ?? 3306 %>" <%= dis %>></label>
      <label>Skrbniški uporabnik<input id="admin_user" name="admin_user" required value="<%= s?.admin_user ?? 'lavrac' %>" <%= dis %>></label>
      <label>Geslo<input id="admin_pass" name="admin_pass" type="password" autocomplete="new-password" <%= s ? '' : 'required' %> placeholder="<%= s ? 'ostane, če je prazno' : '' %>" <%= dis %>></label>
      <label title="<%= locked ? 'Baze že obstajajo, predpone ni več mogoče spremeniti.' : 'Baze dijakov so npr. lr_u12.' %>">Predpona<input id="prefix" name="prefix" value="<%= s?.prefix ?? 'lr_' %>" pattern="[a-z][a-z0-9]{0,8}_" <%= locked || !keyOk ? 'disabled' : '' %>></label>
    </div>
    <div class="cfg-opts">
      <label class="switch"><input type="checkbox" name="tls" <%= !s || s.tls ? 'checked' : '' %> <%= dis %>> Šifrirana povezava (TLS)</label>
      <details class="cfg-more"><summary>+ certifikat CA</summary>
        <p class="dim small">Če strežnik uporablja certifikat, ki ga podpiše tvoj CA, ga prilepi sem (PEM). Brez njega je povezava šifrirana, certifikat strežnika pa se ne preverja.</p>
        <textarea name="ca" rows="4" class="mono" spellcheck="false" placeholder="-----BEGIN CERTIFICATE-----" <%= dis %>><%= s?.ca ?? '' %></textarea>
      </details>
      <details class="cfg-more"><summary>Kako pripraviti strežnik</summary>
        <p class="small">Na strežniku MySQL (8.4 LTS) ustvari skrbniški račun portala. To ni root: sme ustvarjati račune in ima vse pravice samo na baze s predpono.</p>
<pre class="code">CREATE USER 'lavrac'@'<i>IP portala</i>' IDENTIFIED BY '<i>geslo</i>' REQUIRE SSL;
GRANT CREATE USER ON *.* TO 'lavrac'@'<i>IP portala</i>';
GRANT ALL PRIVILEGES ON `<%= (s?.prefix ?? 'lr_').replace(/_/g, '\\_') %>%`.* TO 'lavrac'@'<i>IP portala</i>' WITH GRANT OPTION;</pre>
        <p class="small">V <code>mysqld.cnf</code>: <code>bind-address</code> na naslov v šolskem omrežju, <code>local_infile=0</code>, <code>max_connections=300</code>. Požarni zid: 3306 samo s strežnika portala in iz učilnic (za Workbench), nikoli z interneta. Pravica <code>CREATE USER</code> ni omejena na predpono, zato naj bo strežnik namenjen samo peskovniku, root pa dosegljiv samo lokalno.</p>
      </details>
    </div>
    <fieldset class="cfg-lim"><legend>Omejitve za dijake</legend>
      <label>Čas stavka<span class="u"><input name="timeout" type="number" min="1" max="30" value="<%= limits.timeout %>"> s</span></label>
      <label>Vrstic v izpisu<span class="u"><input name="rows" type="number" min="50" max="5000" value="<%= limits.rows %>"></span></label>
      <label>Velikost baze<span class="u"><input name="sizeMb" type="number" min="1" max="500" value="<%= limits.sizeMb %>"> MB</span></label>
      <label>Dolžina skripta<span class="u"><input name="scriptKb" type="number" min="4" max="512" value="<%= limits.scriptKb %>"> kB</span></label>
      <label>Zagonov / min<span class="u"><input name="perMinute" type="number" min="5" max="300" value="<%= limits.perMinute %>"></span></label>
      <label>Povezav / račun<span class="u"><input name="connections" type="number" min="1" max="20" value="<%= limits.connections %>"></span></label>
    </fieldset>
    <div class="cfg-act"><button class="btn" <%= dis %>>Shrani in preizkusi</button>
      <% if (s && s.checked_at) { %><a class="btn ghost" href="/admin/sql">Prekliči</a><% } %>
      <span class="dim small">Povezave na račun veljajo za nove račune (tudi Workbench šteje).</span></div>
  </form>
</section>
<% } %>

<% if (s) { %>
<section class="block sql-card cfg" id="skupne">
  <div class="cfg-sum">
    <h2>Skupni bazi samo za branje</h2>
    <span class="tag <%= s.shared_at ? 'ok' : 'warn' %>"><%= s.shared_at ? 'uvoženi ' + f.date(s.shared_at) : 'še nista uvoženi' %></span>
    <div class="cfg-push"><form method="post" action="/admin/sql/skupne" data-task="<%= task({ title: s.shared_at ? 'Znova uvozi skupni bazi' : 'Uvozi skupni bazi', lead: 'Skupni bazi sta enaki za vse dijake in jih dijaki lahko samo berejo. Uvoz ju ustvari na strežniku iz datotek, ki so v portalu.', bullets: SHARED.map((x) => 'Baza ' + x.db(s) + ' (' + x.title.replace(/^[^(]*\(|\)$/g, '') + ') se izbriše in znova ustvari iz datoteke ' + x.file.split('/').pop() + '.').concat(['Računu ' + s.prefix + 'bralec se nastavi novo geslo in pravica samo za branje (SELECT) na obe bazi.', 'Osebne baze dijakov se ne dotaknejo. Traja nekaj sekund.']), warn: s.shared_at ? 'Ker se bazi izbrišeta in ustvarita znova, so morebitne ročne spremembe v njiju izgubljene. To je običajno namen: uporabi po spremembi datotek ali če sta bazi pokvarjeni.' : '', confirm: s.shared_at ? 'Znova uvozi' : 'Uvozi' }) %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn <%= s.shared_at ? 'ghost small' : 'small' %>"><%= s.shared_at ? 'Znova uvozi' : 'Uvozi skupni bazi' %></button></form></div>
    <dl class="cfg-dl"><% SHARED.forEach((x) => { %><div><dt><%= x.db(s) %></dt><dd><%= x.title.replace(/^[^(]*\(|\)$/g, '') %></dd></div><% }) %><div><dt>Račun za branje</dt><dd><%= s.prefix %>bralec</dd></div></dl>
    <p class="cfg-line"><%= s.shared_at ? '»Znova uvozi« izbriše obe skupni bazi in ju ustvari znova iz datotek sola.sql in matura_baze.sql v portalu (po spremembi datotek ali če se pokvarita). Dijakove osebne baze ostanejo.' : 'Uvoz ustvari obe skupni bazi iz datotek sola.sql in matura_baze.sql v portalu. Dijaki ju lahko samo berejo.' %></p>
  </div>
</section>

<section class="block" id="pregled">
  <h2>Pregled po razredih</h2>
  <% if (!sqlClasses.length) { %><p class="empty">Ni razredov 4. letnika.</p><% } else { %>
  <div class="scroll"><table class="data">
    <thead><tr><th class="l">Razred</th><th>Dijaki</th><th>Z bazo</th><th>Aktivni v 7 dneh</th><th>Skupaj</th><th class="l"></th></tr></thead>
    <tbody><% sqlClasses.forEach((c) => { %><tr>
      <td class="l"><strong><%= c.name %></strong></td><td><%= c.students %></td><td><%= c.accounts %></td><td><%= c.active %></td><td class="nw"><%= mb(c.bytes) %></td>
      <td class="l"><a href="/ucitelj/razredi/<%= c.id %>/sql">SQL baze razreda</a></td>
    </tr><% }) %></tbody>
  </table></div><% } %>
  <% if (others.length) { %>
  <h3 class="sql-h3">Baze brez razreda (učitelji, dijaki brez razreda)</h3>
  <ul class="sql-people"><% others.forEach((o) => { const l = light(o); %><li><span class="light <%= l %>" title="<%= LIGHTS[l] %>"></span> <%= o.name %> <span class="dim">· <%= o.db_user %> · <%= mb(Number(o.size_bytes) + Number(o.size_bytes6)) %> · <%= o.last_used_at ? f.ago(o.last_used_at) : 'še ni uporabljal' %></span></li><% }) %></ul>
  <% } %>
</section>

<% if (statistics) { const st = statistics, per = st.period, d2 = (n) => String(n).padStart(2, '0'), sm = st.sum;
  const maxRuns = Math.max(1, ...st.days.map((d) => d.runs)); const long = st.days.length > 31;
  const dayLabel = (d) => { const dt = new Date(d.day); return `${dt.getDate()}. ${dt.getMonth() + 1}.`; }; %>
<section class="block" id="statistika">
  <div class="stat-head">
    <h2>Statistika uporabe</h2>
    <nav class="seg" aria-label="Obdobje statistike"><% Object.entries(PERIODS).forEach(([k, label]) => { %><a href="/admin/sql?obdobje=<%= k %>#statistika" class="<%= per.key === k ? 'on' : '' %>" <%- per.key === k ? 'aria-current="true"' : '' %>><%= { 7: '7 dni', 30: 'Mesec', 90: '3 meseci' }[k] %></a><% }) %><a href="#od-do" class="<%= per.key === 'od-do' ? 'on' : '' %>" <%- per.key === 'od-do' ? 'aria-current="true"' : '' %>>Od–do</a></nav>
  </div>
  <form class="stat-range" id="od-do" method="get" action="/admin/sql#statistika"><input type="hidden" name="obdobje" value="od-do">
    <label>Od <input type="date" name="od" value="<%= per.from %>" min="<%= new Date(Date.now() - 89 * 864e5).toISOString().slice(0, 10) %>" max="<%= per.to %>" required></label>
    <label>Do <input type="date" name="do" value="<%= per.to %>" max="<%= per.to %>" required></label>
    <button class="btn small ghost">Prikaži</button>
  </form>
  <p class="dim">Samo števila: kdo je pisal in kaj, se ne beleži v statistiki. Podatki se hranijo <%= KEEP_DAYS %> dni, zato starejšega obdobja ni mogoče izbrati. Prikazano: <strong><%= per.label %></strong><%= per.clamped ? ' (začetek je omejen na hranjene dni)' : '' %>.</p>
  <div class="tiles">
    <div class="tile"><b><%= sm.who %></b><span>dijakov, ki so pisali</span></div>
    <div class="tile"><b><%= sm.runs %></b><span>zagonov</span></div>
    <div class="tile"><b class="<%= sm.failed ? 'weak' : '' %>"><%= sm.failed %></b><span>zagonov z napako<%= sm.runs ? ` (${Math.round(100 * sm.failed / sm.runs)} %)` : '' %></span></div>
    <div class="tile"><b><%= sm.avg === null ? '–' : `${sm.avg} ms` %></b><span>povprečni čas zagona</span></div>
  </div>
  <dl class="cfg-dl cfg-grid">
    <div><dt>Računi</dt><dd><%= st.totals.accounts %> (uporabljeni v 7 dneh: <%= st.totals.active %>, še ne uporabljeni: <%= st.totals.never %>)</dd></div>
    <div><dt>Velikost vseh baz</dt><dd><%= mb(st.totals.bytes) %> (največja <%= mb(st.totals.biggest) %>, nad omejitvijo: <%= st.totals.over %>)</dd></div>
    <div><dt>Čakajo na brisanje</dt><dd><%= st.queued %></dd></div>
    <% if (s && s.selftest_at) { %><div><dt>Zadnji celoten preizkus</dt><dd><%= f.dateTime(s.selftest_at) %> · <%= s.selftest_ok ? 'uspešen' : 'z napakami' %></dd></div><% } %>
  </dl>
  <% if (st.byTarget.length) { %><p>Zagoni po bazi: <%= st.byTarget.map((t) => `${(SHARED.find((x) => x.id === t.target) || { title: t.target === 'moja6' ? 'Moja baza za poglavje 6 (4.6)' : 'Moja baza (4.4)' }).title}: ${t.runs}${t.failed ? ` (napak: ${t.failed})` : ''}`).join(' · ') %></p><% } %>
  <% if (sm.runs) { const w = 100 / st.days.length, days = st.days.slice().reverse(); %>
  <svg class="bars" viewBox="0 0 100 30" preserveAspectRatio="none" role="img" aria-label="Zagoni po dnevih"><% days.forEach((d, i) => { const h = Math.max(d.runs ? 1 : 0, 28 * d.runs / maxRuns), hf = 28 * d.failed / maxRuns; %>
    <rect class="b" x="<%= (i * w + w * 0.12).toFixed(3) %>" y="<%= (29 - h).toFixed(2) %>" width="<%= (w * 0.76).toFixed(3) %>" height="<%= h.toFixed(2) %>"><title><%= dayLabel(d) %>: <%= d.runs %> zagonov</title></rect>
    <% if (d.failed) { %><rect class="f" x="<%= (i * w + w * 0.12).toFixed(3) %>" y="<%= (29 - hf).toFixed(2) %>" width="<%= (w * 0.76).toFixed(3) %>" height="<%= hf.toFixed(2) %>"></rect><% } %><% }) %>
    <line x1="0" y1="29.5" x2="100" y2="29.5" class="ax"/></svg>
  <p class="dim small bars-leg">Stolpci so zagoni po dnevih (temnejši del: z napako), od <%= dayLabel(st.days[st.days.length - 1]) %> do <%= dayLabel(st.days[0]) %></p>
  <% } %>
  <div class="scroll<%= long ? ' tall' : '' %>"><table class="data stat">
    <thead><tr><th class="l">Dan</th><th>Aktivnih</th><th>Zagonov</th><th>Z napako</th><th>Povprečni čas</th></tr></thead>
    <tbody><% st.days.forEach((d) => { %><tr><td class="l"><%= dayLabel(d) %></td><td><%= d.users %></td><td><%= d.runs %></td><td class="<%= d.failed ? 'weak' : '' %>"><%= d.failed %></td><td><%= d.runs ? `${Math.round(Number(d.ms) / d.runs)} ms` : '–' %></td></tr><% }) %></tbody>
  </table></div>
</section>
<% } %>
<section class="block" id="osirotele">
  <h2>Baze brez lastnika</h2>
  <p>Baze na strežniku, ki v portalu nimajo uporabnika (npr. po obnovi stare kopije ali če strežnik ob izbrisu ni bil dosegljiv). <% if (queued) { %><strong>Za brisanje čaka še <%= queued %> baz izbrisanih uporabnikov</strong>; portal jih izbriše sam, ko je strežnik dosegljiv.<% } %></p>
  <% if (orphanList && orphanList.length) { %>
  <form method="post" action="/admin/sql/osirotele" data-task="<%= task({ title: 'Brisanje baz brez lastnika', lead: 'Izbrane baze in njihovi računi se z strežnika MySQL izbrišejo trajno.', bullets: ['Za vsako označeno bazo se izbriše baza in račun z istim imenom.', 'Pred brisanjem portal še enkrat preveri, da baza res nima lastnika (baz dijakov, ki imajo račun v portalu, ne izbriše).'], warn: 'Podatkov ni mogoče obnoviti.', danger: true, confirm: 'Izbriši' }) %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="akcija" value="izbrisi">
    <ul class="checks"><% orphanList.forEach((n) => { %><li><label><input type="checkbox" name="db" value="<%= n %>" checked> <code><%= n %></code></label></li><% }) %></ul>
    <button class="btn danger">Izbriši izbrane baze in račune</button>
  </form>
  <% } else { %>
  <form method="post" action="/admin/sql/osirotele" data-task="<%= task({ title: 'Iskanje baz brez lastnika', lead: 'Portal pregleda strežnik in primerja baze s seznamom računov v portalu.', bullets: ['Samo bere seznam baz s predpono ' + s.prefix + 'u…; nič ne spremeni.', 'Najdene baze pokaže na seznamu, kjer jih lahko izbrišeš.'], confirm: 'Poišči' }) %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn ghost">Poišči na strežniku</button></form>
  <% } %>
</section>
<% } %>
<%- include('../partials/foot') %>
