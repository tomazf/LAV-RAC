<%- include('../partials/head', { pageTitle: 'SQL peskovnik', mainClass: 'wide sqlmain' }) %>
<link rel="stylesheet" href="<%= asset('css/sqlbox.css') %>">
<% const f = fmt; %>
<div class="sq-head">
  <div>
    <h1>SQL peskovnik</h1>
    <p class="dim sq-sub">Stavki se izvedejo na šolskem strežniku MySQL<% if (s.server_version) { %> <%= s.server_version.split('-')[0] %><% } %>. V svoji bazi lahko vse, skupne baze samo bereš.</p>
  </div>
  <div class="sq-target">
    <label for="sq-db">Baza</label>
    <select id="sq-db"><% targets.forEach((t) => { const mine = !!PERSONAL[t.id]; const real = mine ? (acc ? acc[PERSONAL[t.id].col] : null) : SHARED.find((x) => x.id === t.id)?.db(s); %><option value="<%= t.id %>" data-real="<%= real || '' %>" data-title="<%= t.title %>" data-ro="<%= mine ? '' : '1' %>" <%= t.id === start ? 'selected' : '' %> <%= mine && !real ? 'disabled' : '' %>><%= mine ? (real ? `${t.title}: ${real}` : `${t.title} (še ni ustvarjena)`) : `${t.title} · samo branje` %></option><% }) %></select>
  </div>
</div>
<p class="sq-banner" id="sq-banner" role="status" aria-live="polite"></p>
<% if (message) { %><p class="notice" role="status"><%= message %></p><% } %>
<% if (error) { %><p class="notice-warn" role="alert"><%= error %></p><% } %>
<% if (!acc) { %>
<div class="notice-warn sq-noacc"><% if (user.isTeacher) { %>Še nimaš svoje baze za preizkušanje. <form method="post" action="/sql/ustvari" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn small">Ustvari mojo bazo</button></form><% } else { %>Tvoje baze učitelj še ni ustvaril.<%= targets.length > 1 ? ' Skupne baze lahko že bereš.' : '' %><% } %></div>
<% } %>
<noscript><p class="notice-warn">Peskovnik potrebuje JavaScript.</p></noscript>

<div class="sq" id="sq" data-csrf="<%= csrf %>" data-nonce="<%= styleNonce %>" data-has="<%= acc ? '1' : '' %>" data-rows="<%= limits.rows %>" data-timeout="<%= limits.timeout %>" hidden>
  <aside class="sq-side" aria-label="Zgradba baze">
    <div class="sq-side-h"><h2 id="sq-tables-h">Tabele</h2>
      <button type="button" class="sq-ibtn" id="sq-refresh" title="Osveži tabele" aria-label="Osveži tabele"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20 11a8 8 0 1 0-2.3 5.7M20 5v6h-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button></div>
    <div id="sq-tree" class="sq-tree" aria-labelledby="sq-tables-h" aria-live="polite"><p class="dim">Nalagam …</p></div>
    <div class="sq-side-actions">
      <button type="button" class="btn ghost small" id="sq-er-open">ER diagram</button>
      <% if (acc) { %><button type="button" class="btn ghost small" data-open="sq-wb">Podatki za Workbench</button>
      <button type="button" class="btn ghost small" data-open="sq-acc">Moj račun in pravice</button>
      <button type="button" class="btn ghost small" data-open="sq-reset">Ponastavi bazo</button><% } %>
    </div>
  </aside>

  <section class="sq-work" aria-label="Urejevalnik in rezultati">
    <div class="sq-bar" role="toolbar" aria-label="Ukazi">
      <button type="button" class="btn sq-run" id="sq-run" title="Ctrl+Enter"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M7 4l13 8-13 8z" fill="currentColor"/></svg><span id="sq-run-l">Zaženi vse</span></button>
      <button type="button" class="btn ghost" id="sq-run1" title="Ctrl+Shift+Enter">Zaženi stavek</button>
      <span class="sq-sep" aria-hidden="true"></span>
      <button type="button" class="btn ghost small" data-open="sq-scripts">Skripti</button>
      <button type="button" class="btn ghost small" data-open="sq-hist">Zgodovina</button>
      <span class="sq-status dim" id="sq-saved" role="status"></span>
    </div>
    <div class="sq-ed" id="sq-ed"></div>
    <p class="sq-tip dim">Ctrl+Enter zažene vse (ali izbrano), Ctrl+Shift+Enter stavek pod kazalcem. Vsak zagon je nova povezava: spremenljivke, začasne tabele in transakcije ne ostanejo do naslednjega zagona.</p>
    <div class="sq-out" id="sq-out" aria-live="polite">
      <div class="sq-empty"><p><strong>Rezultati se pokažejo tukaj.</strong></p><p class="dim">Za vsak stavek dobiš svoj zavihek: tabelo, število spremenjenih vrstic ali napako z vrstico v urejevalniku.</p></div>
    </div>
  </section>
</div>

<% if (acc) { %>
<dialog class="edit-dlg sq-dlg" id="sq-wb" aria-labelledby="sq-wb-h">
  <div class="edit-form">
    <h2 id="sq-wb-h">Povezava iz MySQL Workbencha</h2>
    <p>V Workbenchu: <strong>Database › Manage Connections › New</strong>, vpiši spodnje podatke in shrani geslo (<em>Store in Vault</em>). Deluje v šolskem omrežju.</p>
    <dl class="cred">
      <div><dt>Hostname</dt><dd><code data-copy><%= s.host %></code></dd></div>
      <div><dt>Port</dt><dd><code data-copy><%= s.port %></code></dd></div>
      <div><dt>Username</dt><dd><code data-copy><%= acc.db_user %></code></dd></div>
      <div><dt>Password</dt><dd><code data-copy class="sq-secret"><%= pass || '(geslo ni dosegljivo, vprašaj učitelja)' %></code></dd></div>
      <div><dt>Default Schema (4.4)</dt><dd><code data-copy><%= acc.db_name %></code></dd></div>
      <div><dt>Poglavje 6 (4.6)</dt><dd><code data-copy><%= acc.db_name6 %></code></dd></div>
    </dl>
    <% if (s.ca) { %>
    <h3 class="sql-h3">Šifrirana povezava (SSL)</h3>
    <p><a class="btn ghost small" href="/sql/ca.pem" download="ca.pem">Prenesi ca.pem</a></p>
    <p>V Workbenchu odpri zavihek <strong>SSL</strong>, pri <strong>Use SSL</strong> izberi <code>Require and Verify CA</code> in pri <strong>SSL CA File</strong> izberi preneseno datoteko <code>ca.pem</code>. <code>Verify Identity</code> ne izbiraj: certifikat je samopodpisan in ime strežnika se ne ujema.</p>
    <% } else if (s.tls) { %>
    <p class="dim">Strežnik podpira šifrirano povezavo: v Workbenchu na zavihku <strong>SSL</strong> pri <strong>Use SSL</strong> izberi <code>Require</code>.</p>
    <% } %>
    <p class="dim">Klik na podatek ga kopira. Za poglavje 6 v Workbenchu izberi bazo <code><%= acc.db_name6 %></code> (dvoklik na ime v levem stolpcu) ali napiši <code>USE <%= acc.db_name6 %>;</code>. Geslo ti lahko ponastavi učitelj.</p>
    <div class="dlg-actions"><button type="button" class="btn ghost" data-close>Zapri</button></div>
  </div>
</dialog>
<dialog class="edit-dlg sq-dlg" id="sq-acc" aria-labelledby="sq-acc-h">
  <div class="edit-form">
    <h2 id="sq-acc-h">Moj SQL račun in pravice</h2>
    <p>Tvoj uporabnik na strežniku je <code data-copy><%= acc.db_user %></code> (geslo je v oknu »Podatki za Workbench«). Z njim lahko:</p>
    <ul>
      <li>v bazi <code><%= acc.db_name %></code> (<%= PERSONAL.moja.title %>) in v bazi <code><%= acc.db_name6 %></code> (<%= PERSONAL.moja6.title %>) delaš karkoli: ustvarjaš, spreminjaš in brišeš tabele, poglede, indekse in podatke;</li>
      <li>v skupnih bazah <code><%= SHARED.map((x) => x.db(s)).join('</code> in <code>') %></code> samo bereš (<code>SELECT</code>), to je za poglavje 4.5;</li>
      <li>nimaš pravic nad drugimi bazami: ne moreš ustvariti novih baz, videti baz drugih dijakov ali dajati pravic drugim;</li>
      <li>imaš lahko največ <%= limits.connections %> hkratnih povezav (Workbench in peskovnik skupaj).</li>
    </ul>
    <p>Pravice v jeziku SQL (podobno vrne <code>SHOW GRANTS;</code>, ki ga lahko zaženeš v urejevalniku):</p>
    <pre class="sq-code"><code>GRANT ALL PRIVILEGES ON `<%= acc.db_name.replace(/_/g, '\\_') %>`.* TO '<%= acc.db_user %>'@'%';
GRANT ALL PRIVILEGES ON `<%= acc.db_name6.replace(/_/g, '\\_') %>`.* TO '<%= acc.db_user %>'@'%';
-- skupne baze (račun <%= s.prefix %>bralec, samo branje):
<% SHARED.forEach((x) => { %>GRANT SELECT, SHOW VIEW ON `<%= x.db(s).replace(/_/g, '\\_') %>`.* TO '<%= s.prefix %>bralec'@'%';
<% }) %></code></pre>
    <p class="dim">Poševnica pred podčrtajem je samo zapis v ukazu GRANT, ime baze je <code><%= acc.db_name6 %></code>. Ob vsakem zagonu v peskovniku je izbrana baza že nastavljena (<code>USE</code> ni potreben); ime izbrane baze piše nad urejevalnikom.</p>
    <div class="dlg-actions"><button type="button" class="btn ghost" data-close>Zapri</button></div>
  </div>
</dialog>
<dialog class="edit-dlg sq-dlg" id="sq-reset" aria-labelledby="sq-reset-h">
  <form class="edit-form" method="post" action="/sql/ponastavi"><input type="hidden" name="_csrf" value="<%= csrf %>">
    <h2 id="sq-reset-h">Ponastavi mojo bazo</h2>
    <p>Ponastavi se samo ena baza, tista, ki ji pripada izbrana vsebina. Druga ostane, kakršna je.</p>
    <ul class="sq-dbs">
      <li><strong><%= PERSONAL.moja.title %></strong>: <code><%= acc.db_name %></code> (<%= mb(acc.size_bytes) %> od <%= limits.sizeMb %> MB)</li>
      <li><strong><%= PERSONAL.moja6.title %></strong>: <code><%= acc.db_name6 %></code> (<%= mb(acc.size_bytes6) %> od <%= limits.sizeMb %> MB)</li>
    </ul>
    <div class="field"><label for="sq-tpl">Začetna vsebina</label>
      <select id="sq-tpl" name="predloga">
        <% Object.entries(PERSONAL).forEach(([k, p]) => { %><optgroup label="<%= p.title %> · <%= acc[p.col] %>"><% TEMPLATES.filter((t) => t.db === k).forEach((t) => { %><option value="<%= t.id %>" <%= t.id === 'p6k0' ? 'selected' : '' %>><%= t.title %></option><% }) %></optgroup><% }) %>
      </select></div>
    <label class="switch"><input type="checkbox" name="potrdi" required> Vse tabele in podatki v izbrani bazi se izbrišejo.</label>
    <div class="dlg-actions"><button class="btn danger">Ponastavi</button><button type="button" class="btn ghost" data-close>Prekliči</button></div>
  </form>
</dialog>
<% } %>
<dialog class="edit-dlg sq-dlg" id="sq-scripts" aria-labelledby="sq-scripts-h">
  <div class="edit-form">
    <h2 id="sq-scripts-h">Moji skripti</h2>
    <form class="row" id="sq-save"><label class="sr" for="sq-name">Ime skripta</label><input id="sq-name" maxlength="80" placeholder="Ime, npr. 4.4 vaja C3" required><button class="btn small">Shrani trenutnega</button></form>
    <p class="sq-msg dim" id="sq-scripts-msg" role="status"></p>
    <ul class="sq-list" id="sq-scripts-list"></ul>
    <div class="dlg-actions"><button type="button" class="btn ghost" data-close>Zapri</button></div>
  </div>
</dialog>
<dialog class="edit-dlg sq-dlg" id="sq-hist" aria-labelledby="sq-hist-h">
  <div class="edit-form">
    <h2 id="sq-hist-h">Zgodovina zagonov</h2>
    <p class="dim">Zadnjih 100 zagonov. Vidiš jih samo ti. Klik prenese skript v urejevalnik.</p>
    <ul class="sq-list" id="sq-hist-list"></ul>
    <div class="dlg-actions"><button type="button" class="btn ghost" data-close>Zapri</button></div>
  </div>
</dialog>
<dialog class="sq-er" id="sq-er" aria-labelledby="sq-er-h">
  <div class="sq-er-bar">
    <h2 id="sq-er-h">ER diagram · <span id="sq-er-db"></span></h2>
    <div class="row">
      <button type="button" class="btn ghost small" id="sq-er-minus" aria-label="Pomanjšaj">−</button>
      <button type="button" class="btn ghost small" id="sq-er-plus" aria-label="Povečaj">+</button>
      <button type="button" class="btn ghost small" id="sq-er-fit">Prilagodi</button>
      <button type="button" class="btn ghost small" id="sq-er-svg">Prenesi SVG</button>
      <button type="button" class="btn small" data-close>Zapri</button>
    </div>
  </div>
  <p class="dim sq-er-tip">Tabele lahko premikaš z miško. Ključ: primarni ključ · → tuji ključ.</p>
  <div class="sq-er-canvas" id="sq-er-canvas"></div>
</dialog>
<textarea id="sq-draft" hidden aria-hidden="true"><%= draft %></textarea>
<script src="<%= asset('js/vendor/sqleditor.js') %>"></script>
<script src="<%= asset('js/sqlbox.js') %>"></script>
<%- include('../partials/foot') %>
