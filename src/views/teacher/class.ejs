<%- include('../partials/head', { pageTitle: cls.name, mainClass: 'wide' }) %>
<% const f = fmt; const sl = (key, text) => `<a href="?sort=${key}" ${sort===key?'aria-current="true"':''}>${text}</a>`; %>
<p class="crumbs"><a href="/ucitelj">Razredi</a></p>
<div class="title-row"><h1><%= cls.name %></h1>
  <div class="row"><a class="btn" href="/ucitelj/razredi/<%= cls.id %>/vaje">Vaje razreda (<%= openCount %> od <%= list.length %>)</a>
  <a class="btn ghost" href="#dodaj">Dodaj dijake (<%= unassigned.length %>)</a>
  <a class="btn ghost" href="/ucitelj/razredi/<%= cls.id %>/izvoz.csv">Izvozi CSV</a></div>
</div>
<p class="dim team">Učitelji: <%= teachers.map((t) => t.name).join(', ') || 'še brez učitelja' %></p>
<% if (!openCount) { %><p class="notice-warn">Dijaki tega razreda še ne vidijo nobene vaje. <a href="/ucitelj/razredi/<%= cls.id %>/vaje">Izberi vaje</a>.</p><% } %>
<dl class="stats">
  <div><dt>Dijaki</dt><dd><%= rows.length %></dd></div>
  <div><dt>Povprečje točk</dt><dd><%= stats.avg %> %</dd></div>
  <div><dt>Aktivni v 7 dneh</dt><dd><%= stats.active %></dd></div>
  <div><dt>Še niso začeli</dt><dd><%= stats.never %></dd></div>
  <div><dt>Povprečni čas</dt><dd><%= f.duration(stats.seconds) %></dd></div>
</dl>
<% if (!rows.length) { %><p class="empty">V razredu še ni dijakov. Dodaj jih s seznama spodaj.</p><% } else { %>
<p class="sorter">Razvrsti: <%- sl('name','po imenu') %> <%- sl('score','po točkah') %> <%- sl('time','po času') %> <%- sl('last','po zadnji aktivnosti') %></p>
<div class="scroll matrix-wrap" tabindex="0" role="region" aria-label="Rezultati razreda po vajah">
<table class="matrix">
  <thead><tr><th class="l stick">Dijak</th>
    <% list.forEach((e) => { %><th class="<%= e.visible ? '' : 'closed' %>" title="<%= e.title %><%= e.visible ? '' : ' (zaprta)' %>"><a href="/ucitelj/razredi/<%= cls.id %>/rezultati/<%= e.id %>"><%= e.id %></a></th><% }) %>
    <th>Odprte vaje</th><th>Čas</th><th class="l">Zadnja aktivnost</th></tr></thead>
  <tbody>
  <% rows.forEach((r) => { %><tr>
    <td class="l stick"><a href="/ucitelj/razredi/<%= cls.id %>/dijaki/<%= r.id %>"><%= r.name %></a></td>
    <% list.forEach((e) => { const c = cell(r.cells, e.id); const p = f.pct(c.score, e.maxPoints); const d = f.pct(c.done, e.tasks.length); %>
    <td class="heat <%= e.visible ? '' : 'closed' %>" style="--p:<%= p %>" title="<%= e.id %>: <%= f.num(c.score) %> od <%= e.maxPoints %> t, <%= c.done %> od <%= e.tasks.length %> nalog, <%= f.duration(c.seconds) %><%= c.resets ? `, ponastavitve: ${c.resets}` : '' %>">
      <% if (c.started) { %><span class="hv"><%= p %></span><% if (c.resets) { %><span class="rs" aria-label="Ponastavitve: <%= c.resets %>">↺<%= c.resets %></span><% } %><span class="hb" style="width:<%= d %>%"></span><% } else { %><span class="hn">–</span><% } %>
    </td><% }) %>
    <td><strong><%= f.pct(r.total.score, maxPoints) %> %</strong></td>
    <td class="nw"><%= f.duration(r.total.seconds) %></td>
    <td class="l nw"><%= f.ago(r.total.last) %></td>
  </tr><% }) %>
  </tbody>
</table></div>
<p class="dim note">Število je delež doseženih točk v odstotkih, črta pod njim delež rešenih nalog. ↺ pomeni ponastavitve. Zatemnjene vaje so za dijake zaprte. Pomakni miško nad celico za podrobnosti.</p>
<% } %>
<section class="block" id="dodaj">
  <h2>Dodaj dijake brez razreda</h2>
  <% if (!unassigned.length) { %><p class="empty">Vsi prijavljeni dijaki imajo razred. Dijak se pojavi tukaj po prvi prijavi.</p><% } else { %>
  <form method="post" action="/ucitelj/razredi/<%= cls.id %>/dodaj"><input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="row"><label class="sr" for="iskanje">Išči po imenu</label><input id="iskanje" type="search" data-filter="#cakajo" placeholder="Išči po imenu ali računu"><button class="btn">Dodaj izbrane</button></div>
    <ul class="checks" id="cakajo"><% unassigned.forEach((w) => { %><li><label><input type="checkbox" name="user" value="<%= w.id %>"> <%= w.name %> <span class="dim"><%= w.email || w.username %></span></label></li><% }) %></ul>
  </form>
  <script src="<%= asset('js/filter.js') %>"></script>
  <% } %>
</section>
<section class="block">
  <h2>Razred</h2>
  <% if (cls.iTeach) { %>
  <details class="danger-zone"><summary>Zapusti razred</summary>
    <p>Razred ostane, dijaki obdržijo vaje in napredek. Znova se mu lahko pridružiš kadar koli.</p>
    <form method="post" action="/ucitelj/razredi/<%= cls.id %>/zapusti"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn danger">Da, zapusti razred <%= cls.name %></button></form>
  </details>
  <% } else { %>
  <form method="post" action="/ucitelj/razredi/<%= cls.id %>/pridruzi"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn ghost">Pridruži se razredu</button></form>
  <% } %>
  <% if (user.isAdmin) { %><p><a href="/admin/razredi">Preimenuj ali izbriši razred</a></p><% } %>
</section>
<%- include('../partials/foot') %>
