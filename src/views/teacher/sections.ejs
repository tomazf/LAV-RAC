<%- include('../partials/head', { pageTitle: 'Vaje razreda', mainClass: 'wide' }) %>
<p class="crumbs"><a href="/ucitelj">Razredi</a> / <a href="/ucitelj/razredi/<%= cls.id %>"><%= cls.name %></a></p>
<div class="title-row"><h1>Vaje razreda <%= cls.name %></h1></div>
<p>Dijaki tega razreda vidijo samo označene vaje, v tem vrstnem redu. <strong class="nw">Odprtih: <%= openCount %> od <%= exerciseCount %>.</strong></p>
<% mods.forEach((m) => { %>
<section class="group" id="skupina-<%= m.id %>">
  <h2><%= m.id %> <%= m.title %></h2>
  <div class="scroll"><table class="data ex-table"><colgroup><col class="c-title"><col class="c-num"><col class="c-num"><col class="c-vis"><col class="c-order"></colgroup>
  <thead><tr><th class="l">Vaja</th><th>Naloge</th><th>Točke</th><th class="l">Vidijo dijaki</th><th class="l">Vrstni red</th></tr></thead><tbody>
    <% m.exercises.forEach((e, i) => { %><tr id="vaja-<%= e.id %>" class="<%= e.visible ? '' : 'unseen' %>">
      <td class="l"><a href="/vaje/<%= e.id %>"><strong><%= e.no %></strong> <%= e.title %></a></td><td><%= e.tasks.length %></td><td><%= e.maxPoints %></td>
      <td class="l"><form class="inline tight" method="post" action="/ucitelj/razredi/<%= cls.id %>/vaje/<%= e.id %>/vidnost" data-autosubmit><input type="hidden" name="_csrf" value="<%= csrf %>">
        <label class="switch"><input type="checkbox" name="visible" <%= e.visible ? 'checked' : '' %>> <%= e.visible ? 'odprta' : 'zaprta' %></label>
        <noscript><button class="btn ghost small">Shrani</button></noscript></form></td>
      <td class="l"><form class="inline tight" method="post" action="/ucitelj/razredi/<%= cls.id %>/vaje/<%= e.id %>/premik"><input type="hidden" name="_csrf" value="<%= csrf %>">
        <button class="btn ghost small" name="dir" value="up" <%= i === 0 ? 'disabled' : '' %>>Gor</button><button class="btn ghost small" name="dir" value="down" <%= i === m.exercises.length - 1 ? 'disabled' : '' %>>Dol</button></form></td>
    </tr><% }) %>
  </tbody></table></div>
</section>
<% }) %>
<% plannedModules.forEach((id) => { %><section class="group planned"><h2><%= id %> V pripravi</h2><p class="planned-row">Vaje te skupine še niso dodane.</p></section><% }) %>
<script src="<%= asset('js/autosubmit.js') %>"></script>
<%- include('../partials/foot') %>
