<%- include('../partials/head', { pageTitle: 'Razredi' }) %>
<div class="title-row"><h1>Razredi</h1>
  <% if (user.isAdmin) { %><a class="btn ghost" href="/admin/razredi">Upravljaj razrede</a><% } %>
</div>
<section>
  <h2>Moji razredi</h2>
  <% if (!mine.length) { %><p class="empty">Še nisi v nobenem razredu. Pridruži se razredu spodaj.</p><% } else { %>
  <div class="scroll"><table class="data">
    <thead><tr><th class="l">Razred</th><th>Dijaki</th><th>Odprte vaje</th><th>Povprečje točk</th><th>Aktivni v 7 dneh</th><th class="l">Učitelji</th></tr></thead>
    <tbody><% mine.forEach((c) => { %><tr>
      <td class="l"><a href="/ucitelj/razredi/<%= c.id %>"><strong><%= c.name %></strong></a></td>
      <td><%= c.students %></td><td><a href="/ucitelj/razredi/<%= c.id %>/vaje"><%= c.open_count %> od <%= exerciseCount %></a></td><td><%= c.avg %> %</td><td><%= c.activeWeek %></td><td class="l"><%= c.teachers %></td>
    </tr><% }) %></tbody>
  </table></div><% } %>
</section>
<section class="block">
  <h2>Ostali razredi</h2>
  <% if (!others.length) { %><p class="empty"><%= mine.length ? 'Drugih razredov ni.' : 'Skrbnik še ni ustvaril razredov.' %></p><% } else { %>
  <div class="scroll"><table class="data">
    <thead><tr><th class="l">Razred</th><th>Dijaki</th><th class="l">Učitelji</th><th class="l">Dejanje</th></tr></thead>
    <tbody><% others.forEach((c) => { %><tr>
      <td class="l"><% if (user.isAdmin) { %><a href="/ucitelj/razredi/<%= c.id %>"><strong><%= c.name %></strong></a><% } else { %><strong><%= c.name %></strong><% } %></td>
      <td><%= c.students %></td><td class="l"><%= c.teachers || 'še brez učitelja' %></td>
      <td class="l"><form method="post" action="/ucitelj/razredi/<%= c.id %>/pridruzi"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn ghost small">Pridruži se</button></form></td>
    </tr><% }) %></tbody>
  </table></div><% } %>
</section>
<section class="block">
  <h2>Dijaki brez razreda (<%= unassigned.length %>)</h2>
  <% if (!unassigned.length) { %><p class="empty">Vsi prijavljeni dijaki imajo razred.</p><% } else { %>
  <p>Odpri svoj razred in jih dodaj s seznama.</p>
  <ul class="names"><% unassigned.forEach((w) => { %><li><%= w.name %> <span class="dim"><%= w.email || w.username %></span></li><% }) %></ul>
  <% } %>
</section>
<%- include('../partials/foot') %>
