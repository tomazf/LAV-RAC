<%# The way in, as lamps: a = school account, b = class. The exercises light up only when both are on. %>
<% const out = a && b; const lit = (v) => v ? 'status on' : 'status'; %>
<ul class="gate-fig" aria-label="<%= a ? 'Šolski račun je prijavljen' : 'Šolski račun še ni prijavljen' %>, <%= b ? 'razred je dodeljen' : 'razred še ni dodeljen' %>, vaje so <%= out ? 'odprte' : 'zaprte' %>.">
  <li class="<%= lit(a) %>"><i></i>Šolski račun = <%= a ? 1 : 0 %></li>
  <li class="<%= lit(b) %>"><i></i>Razred = <%= b ? 1 : 0 %></li>
  <li class="<%= lit(out) %>"><i></i>Vaje = <%= out ? 1 : 0 %></li>
</ul>
