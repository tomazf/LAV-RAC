<!doctype html>
<html lang="sl"<%- htmlPrefs %>>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' | ' + portal.name : portal.name %></title>
<%- fontPreloads %>
<link rel="stylesheet" href="<%= asset('fonts/fonts.css') %>">
<link rel="stylesheet" href="<%= asset('css/app.css') %>">
<link rel="stylesheet" href="<%= asset('css/panel.css') %>">
<% if (user) { %><link rel="stylesheet" href="<%= asset('css/hdr.css') %>">
<script src="<%= asset('js/hdr.js') %>" defer></script><% } %>
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="icon" href="<%= asset('favicon.svg') %>" type="image/svg+xml">
</head>
<body>
<a class="skip" href="#vsebina">Skoči na vsebino</a>
<header class="top">
  <div class="top-in">
    <a class="brand" href="/" aria-label="<%= portal.name %>, začetna stran">
      <svg viewBox="0 0 28 14" width="42" height="21" aria-hidden="true"><% [0,1,0,1,0,0,1,0].forEach((b, i) => { %><circle class="<%= b ? 'on' : 'off' %>" cx="<%= 3 + (i % 4) * 7.3 %>" cy="<%= i < 4 ? 3.5 : 10.5 %>" r="2.5"/><% }) %></svg>
      <span><%= portal.name %></span>
    </a>
    <% if (portal.school && typeof schoolLogo !== 'undefined' && schoolLogo) { %>
    <a class="school-logo" href="<%= portal.school.url %>" target="_blank" rel="noopener" aria-label="<%= portal.school.name %>, spletna stran (odpre nov zavihek)"><img src="<%= asset(portal.school.logo) %>" alt="<%= portal.school.name %>" height="40"></a>
    <% } %>
    <% if (user) { %>
    <nav aria-label="Glavni meni">
      <% if (!user.isWaiting) { %><a href="/vaje" <%- path.startsWith('/vaje') ? 'aria-current="page"' : '' %>>Vaje</a><% } %>
      <% if (user.sqlOn) { %><a href="/sql" <%- path.startsWith('/sql') ? 'aria-current="page"' : '' %>>SQL peskovnik</a><% } %>
      <% if (user.isTeacher) { %><a href="/ucitelj" <%- path.startsWith('/ucitelj') ? 'aria-current="page"' : '' %>>Razredi</a><% } %>
      <% if (user.isTeacher) { const rp = user.isAdmin ? '/admin/prijave' : '/ucitelj/prijave'; %><a href="<%= rp %>" <%- path.startsWith(rp) ? 'aria-current="page"' : '' %>>Prijave<% if (user.reportsOpen) { %> <span class="cnt" aria-label="<%= user.reportsOpen %> odprtih"><%= user.reportsOpen %></span><% } %></a><% } %>
      <% if (user.isAdmin) { %><a href="/admin" <%- path.startsWith('/admin') && !path.startsWith('/admin/prijave') ? 'aria-current="page"' : '' %>>Administracija</a><% } %>
    </nav>
    <div class="who" id="hd-root" data-csrf="<%= csrf %>" data-report="<%= !user.isAdmin && !user.isWaiting ? '1' : '' %>" data-unseen="<%= user.reports_unseen || 0 %>">
      <span class="who-name"><%= user.name %></span>
      <form method="post" action="/auth/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="linkish">Odjava</button></form>
    </div>
    <% } %>
  </div>
</header>
<main id="vsebina" class="<%= typeof mainClass !== 'undefined' ? mainClass : '' %>">
