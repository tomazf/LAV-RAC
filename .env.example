# Kopiraj v .env in izpolni. Datoteke .env ne dodaj v Git.

# Javni naslov portala, brez poševnice na koncu
PUBLIC_URL=https://lavrac.sc-nm.si

# Samo za Caddy (docker compose --profile https): domena brez https://
DOMAIN=lavrac.sc-nm.si

# Registracija aplikacije v Entra
OIDC_TENANT_ID=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Skrbniki: uporabniška imena (UPN) za prijavo, ločena z vejico
ADMIN_EMAILS=tomaz.ferbezar@sc-nm.si

# Naključni nizi, ustvari z: openssl rand -hex 32
SESSION_SECRET=
POSTGRES_PASSWORD=

# SQL peskovnik (4. letnik): ključ za šifriranje gesel MySQL v bazi portala, ustvari z: openssl rand -base64 32
# Brez njega je peskovnik izklopljen. Ni del varnostne kopije: shrani ga posebej.
SQL_KEY=

# Kje posluša aplikacija. Privzeto samo na tem strežniku, za obratni posredovalnik ali Caddy.
# BIND_ADDRESS=127.0.0.1
# Če na istem strežniku že teče LAV-ELS (vrata 4000), tukaj nastavi druga vrata.
APP_PORT=4001
